{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 23 * * 0",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Every Sunday night at 11pm ET: pulls the full list of public Invidious instances from the official Invidious instances API (the source behind iv-org/documentation) into the hidden /invidious page.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_invidious_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncInvidiousInstances",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Sync Invidious instances",
            "description": "Full public instance list"
          }
        }
      }
    ]
  },
  "name": "Weekly Invidious Sync"
}