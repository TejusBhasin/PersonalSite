{
  "name": "InvidiousInstance",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Instance hostname, e.g. inv.nadeko.net"
    },
    "uri": {
      "type": "string",
      "description": "Full base URL of the instance"
    },
    "flag": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "description": "Access type, e.g. https"
    },
    "api": {
      "type": "boolean",
      "description": "Whether the instance reports its API as publicly accessible"
    },
    "cors": {
      "type": "boolean"
    },
    "uptime": {
      "type": "number",
      "description": "Uptime percentage reported by uptime.invidious.io"
    },
    "down": {
      "type": "boolean",
      "default": false
    },
    "error": {
      "type": "string",
      "description": "Monitor error message when the instance is down"
    },
    "version": {
      "type": "string",
      "description": "Invidious software version the instance runs"
    },
    "branch": {
      "type": "string"
    },
    "users": {
      "type": "integer",
      "description": "Total registered users on the instance"
    },
    "open_registrations": {
      "type": "boolean"
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    }
  },
  "required": [
    "name",
    "uri"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}