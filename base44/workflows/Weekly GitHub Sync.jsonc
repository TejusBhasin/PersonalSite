{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 10 * * 1",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Every Monday at 10am: pulls Tejus's public GitHub repos into the site's projects, embeds READMEs, and writes a weekly devlog of what changed.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_github_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncGithubProjects",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Sync GitHub projects",
            "description": "Repos, READMEs, devlog"
          }
        }
      }
    ]
  },
  "name": "Weekly GitHub Sync"
}