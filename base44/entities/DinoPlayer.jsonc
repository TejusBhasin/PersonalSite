{
  "name": "DinoPlayer",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "description": "The name the player signed up with"
    },
    "handle": {
      "type": "string",
      "description": "Lowercased username, used for lookups"
    },
    "salt": {
      "type": "string",
      "description": "Random salt mixed into the password before hashing"
    },
    "password_hash": {
      "type": "string",
      "description": "SHA-256 hex of salt + password; the password itself is never stored"
    },
    "session_token": {
      "type": "string",
      "description": "Token handed to the browser at sign-in, used to submit scores"
    },
    "password": {
      "type": "string",
      "description": "Legacy plaintext password from before hashing; cleared on the next sign-in"
    },
    "best_score": {
      "type": "integer",
      "default": 0,
      "description": "The player's best Chrome Dino run \u2014 also serves as their leaderboard entry"
    }
  },
  "required": [
    "username",
    "handle"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}