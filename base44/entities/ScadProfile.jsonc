{
  "name": "ScadProfile",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "description": "Public handle, unique per user"
    },
    "display_name": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "printer": {
      "type": "string"
    },
    "nozzle_diameter": {
      "type": "number",
      "default": 0.4
    },
    "filament_type": {
      "type": "string",
      "default": "PLA"
    },
    "slicer": {
      "type": "string",
      "default": "PrusaSlicer"
    },
    "infill_percent": {
      "type": "integer",
      "default": 15
    },
    "layer_height": {
      "type": "number",
      "default": 0.2
    },
    "supports": {
      "type": "boolean",
      "default": false
    },
    "bed_temp": {
      "type": "integer",
      "default": 60
    },
    "nozzle_temp": {
      "type": "integer",
      "default": 210
    },
    "default_visibility": {
      "type": "string",
      "enum": [
        "private",
        "unlisted",
        "public"
      ],
      "default": "private",
      "enumColors": [
        "gray",
        "yellow",
        "green"
      ]
    },
    "autosave": {
      "type": "boolean",
      "default": true
    },
    "editor_font_size": {
      "type": "integer",
      "default": 12
    },
    "editor_tab_width": {
      "type": "integer",
      "default": 2
    }
  },
  "required": [],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}