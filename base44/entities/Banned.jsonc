{
  "name": "Banned",
  "type": "object",
  "properties": {
    "ip": {
      "type": "string",
      "description": "Exact IP to block"
    },
    "device_id": {
      "type": "string",
      "description": "Device to block"
    },
    "cidr": {
      "type": "string",
      "description": "IP range to block, e.g. 192.168.1.0/24 blocks a whole WiFi network"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}