{
  "name": "AmmeInstance",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Which setting this record holds",
      "default": "active"
    },
    "base_url": {
      "type": "string",
      "description": "Base URL of the selected public Invidious instance"
    },
    "instance_name": {
      "type": "string",
      "description": "Name of the instance from the public directory"
    },
    "healthy": {
      "type": "boolean",
      "default": true,
      "description": "Whether the last check found the instance working"
    },
    "checked_date": {
      "type": "string",
      "description": "ISO timestamp of the last health check"
    }
  },
  "required": [
    "key",
    "base_url"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}