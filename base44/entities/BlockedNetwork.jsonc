{
  "name": "BlockedNetwork",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Name of the WiFi network, e.g. 'School WiFi'"
    },
    "ip": {
      "type": "string",
      "description": "The network's public IP address \u2014 everyone on that WiFi shares it"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "ip"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}