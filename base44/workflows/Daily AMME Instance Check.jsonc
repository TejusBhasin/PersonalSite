{
  "description": "Checks the /amme page's Invidious instance every 24 hours and switches to a healthy public instance if it is down",
  "name": "Daily AMME Instance Check",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_amme_instance_check",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_instance": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "ammeCheckInstances",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Check AMME instance",
            "description": "Switch if down"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 4 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}