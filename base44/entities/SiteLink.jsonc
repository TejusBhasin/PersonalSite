{
  "name": "SiteLink",
  "type": "object",
  "properties": {
    "label": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "default": "link"
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    },
    "visible": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "label",
    "url"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}