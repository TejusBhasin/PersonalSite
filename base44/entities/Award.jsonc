{
  "name": "Award",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "issued_date": {
      "type": "string"
    },
    "association": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    },
    "visible": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}