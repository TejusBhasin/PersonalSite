{
  "name": "Project",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "github_url": {
      "type": "string"
    },
    "embed_url": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "preview": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "why": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "readme": {
      "type": "string",
      "description": "The project's GitHub README (markdown), synced weekly"
    },
    "github_pushed_at": {
      "type": "string",
      "description": "Last known GitHub push timestamp, used to detect changes"
    },
    "auto_synced": {
      "type": "boolean",
      "default": false,
      "description": "True if this project was created automatically from GitHub (removed if the repo is deleted)"
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    },
    "visible": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "slug",
    "name",
    "url"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}